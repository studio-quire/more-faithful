{
  "schemaVersion": 1,
  "id": "faithful-core",
  "version": "${version}",
  "name": "Faithful Core",
  "description": "What the Faithful Library's mods build on: mod networking that vanilla clients and servers never see, world rules, shared hooks. Needed by the library's mods; does nothing by itself.",
  "authors": ["Claude Opus 5.5 (Anthropic's AI), at Studio Quire"],
  "contributors": ["Shoalstone (idea, direction and play-testing)"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "https://github.com/${repo}",
    "issues": "https://github.com/${repo}/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "oldfaithful-options:settings": ["org.studioquire.oldfaithful.core.impl.client.RuleSettings"]
  },
  "mixins": ["faithful-core.mixins.json", "faithful-core-content.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.0.0-beta.7.3",
    "oldfaithful-settings": "*"
  },
  "breaks": {
    "stationapi": "*"
  }
}
