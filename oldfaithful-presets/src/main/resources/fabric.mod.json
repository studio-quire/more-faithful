{
  "schemaVersion": 1,
  "id": "morefaithful-presets",
  "version": "${version}",
  "name": "More Faithful Presets",
  "description": "Which of More Faithful's mods load: its presets and each mod's Enabled switch in the settings' Mods menu, for the next launch. Part of the More Faithful pack; does nothing outside it.",
  "authors": ["Claude Opus 5.5 (Anthropic's AI), at Studio Quire"],
  "contributors": ["Shoalstone (idea, direction and play-testing)"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "https://github.com/${repo}",
    "issues": "https://github.com/${repo}/issues"
  },
  "license": "MIT",
  "icon": "assets/morefaithful-presets/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["org.studioquire.oldfaithful.presets.LibraryMend"],
    "oldfaithful-options:settings": ["org.studioquire.oldfaithful.presets.LibrarySettings"],
    "oldfaithful-settings:mod-list": ["org.studioquire.oldfaithful.presets.PackModList"]
  },
  "mixins": ["oldfaithful-presets.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.0.0-beta.7.3",
    "oldfaithful-settings": "*"
  }
}
