{
  "schemaVersion": 1,
  "id": "dry-grass",
  "version": "${version}",
  "name": "Dry Grass",
  "description": "Grass in hot, dry land in a shade other than beta's olive, with the oaks there to match. Only colours, so it shows in worlds you already have and on any server.",
  "authors": ["Claude Opus 5.5 (Anthropic's AI), at Studio Quire"],
  "contributors": ["Shoalstone (idea and direction)"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "https://github.com/${repo}",
    "issues": "https://github.com/${repo}/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "faithful:client": ["org.studioquire.faithful.drygrass.client.DryGrass"],
    "oldfaithful-options:settings": ["org.studioquire.faithful.drygrass.client.DryGrassSettings"]
  },
  "mixins": ["dry-grass.mixins.json"],
  "depends": {
    "faithful-core": "*"
  },
  "custom": {
    "faithful": {}
  }
}
